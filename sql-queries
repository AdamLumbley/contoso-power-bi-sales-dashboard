-- Exploration: top 5 customers by gross profit (list price basis)
-- Contoso V2 100K, SQL Server
WITH top_customers AS (
    SELECT  c.CustomerKey,
            c.GivenName,
            c.Surname,
            SUM(s.UnitPrice * s.Quantity) - SUM(s.UnitCost * s.Quantity) AS gross_profit,
            DENSE_RANK() OVER (ORDER BY SUM(s.UnitPrice * s.Quantity) - SUM(s.UnitCost * s.Quantity) DESC) AS gross_profit_ranking
    FROM Data.Customer c
    JOIN Data.Sales s ON c.CustomerKey = s.CustomerKey
    GROUP BY c.CustomerKey, c.GivenName, c.Surname
)
SELECT *
FROM top_customers
WHERE gross_profit_ranking <= 5;

-- Exploration: total orders by customer gender
WITH base AS (
    SELECT c.Gender,
           COUNT(DISTINCT s.OrderKey) AS Orders
    FROM Data.Customer c
    JOIN Data.Sales s ON c.CustomerKey = s.CustomerKey
    GROUP BY c.Gender
)
SELECT * FROM base;

-- Validation: gross profit by product category (list price basis)
-- Matches DAX: Computers $58.6M, categories sum to $136.1M
WITH gross_profit_by_product_category AS (
    SELECT p.CategoryName,
           SUM(s.UnitPrice * s.Quantity) - SUM(s.UnitCost * s.Quantity) AS gross_profit
    FROM Data.Sales s
    JOIN Data.Product p ON s.ProductKey = p.ProductKey
    GROUP BY p.CategoryName
)
SELECT *
FROM gross_profit_by_product_category
ORDER BY gross_profit DESC;
